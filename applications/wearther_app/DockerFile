FROM python:3.9-slim

WORKDIR /app

# Install system dependencies required for Adafruit Blinka / I2C
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-dev \
    i2c-tools \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
RUN pip install --no-cache-dir adafruit-circuitpython-bmp280

# Copy application script
COPY weather_analyzer.py /app/weather_analyzer.py

CMD ["python", "weather_analyzer.py"]